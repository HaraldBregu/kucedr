{
	"schemaVersion": 5,
	"id": "cohere",
	"title": "Cohere",
	"version": "1.0.0",
	"description": "Command chat models and speech-to-text.",
	"categories": [
		"LLM",
		"STT"
	],
	"author": "Kucedr",
	"icon": "cohere.svg",
	"authentication": "api-key",
	"apiKeyUrl": "https://dashboard.cohere.com/api-keys",
	"icon_dark_url": "/assets/cohere.svg",
	"icon_light_url": "/assets/cohere.svg",
	"models": [
		{
			"id": "cohere-transcribe-03-2026",
			"name": "Cohere Transcribe",
			"type": "speech-to-text-model",
			"authentication": "api-key",
			"url": "https://api.cohere.com/v2",
			"metadata": {
				"documentationUrl": "https://docs.cohere.com/v2/reference/create-audio-transcription",
				"documentationStatus": "verified",
				"inputs": {
					"language": {
						"type": "string",
						"required": true
					},
					"temperature": {
						"type": "number",
						"minimum": 0,
						"maximum": 1
					}
				}
			},
			"location": "remote",
			"apiTypes": [
				"batch"
			]
		},
		{
			"id": "cohere-transcribe-arabic-07-2026",
			"name": "Cohere Transcribe Arabic",
			"type": "speech-to-text-model",
			"authentication": "api-key",
			"url": "https://api.cohere.com/v2",
			"metadata": {
				"documentationUrl": "https://docs.cohere.com/v2/reference/create-audio-transcription",
				"documentationStatus": "verified",
				"inputs": {
					"language": {
						"type": "string",
						"required": true
					},
					"temperature": {
						"type": "number",
						"minimum": 0,
						"maximum": 1
					}
				}
			},
			"location": "remote",
			"apiTypes": [
				"batch"
			]
		},
		{
			"id": "command-a-plus-05-2026",
			"name": "Command A+",
			"type": "large-language-model",
			"authentication": "api-key",
			"url": "https://api.cohere.ai/compatibility/v1",
			"metadata": {
				"documentationUrl": "https://docs.cohere.com/docs/compatibility-api",
				"documentationStatus": "verified",
				"inputs": {
					"max_tokens": {
						"type": "integer",
						"maximum": 64000
					},
					"temperature": {
						"type": "number"
					},
					"top_p": {
						"type": "number"
					},
					"response_format": {
						"type": "object"
					},
					"tools": {
						"type": "array"
					},
					"stop": {
						"type": "array"
					},
					"reasoning_effort": {
						"type": "string",
						"enum": [
							"none",
							"high"
						]
					}
				},
				"contextWindow": 128000,
				"defaultOutputTokens": 8000,
				"contextWindowDocumentationUrl": "https://docs.cohere.com/docs/models",
				"promptAttachments": [
					{
						"kind": "image",
						"mimeTypes": [
							"image/jpeg",
							"image/png",
							"image/webp",
							"image/gif"
						],
						"extensions": [
							".jpg",
							".jpeg",
							".png",
							".webp",
							".gif"
						],
						"maxFiles": 20,
						"maxTotalBytes": 20000000
					}
				]
			},
			"location": "remote"
		}
	]
}
