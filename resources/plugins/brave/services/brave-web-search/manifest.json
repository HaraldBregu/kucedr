{
	"id": "brave-web-search",
	"name": "Brave Web Search",
	"type": "SEARCH_ENGINE",
	"url": "https://api.search.brave.com/res/v1/web/search",
	"authentication": "api-key",
	"settings": [
		{
			"key": "apiKey",
			"label": "API key",
			"type": "password",
			"required": true
		}
	],
	"metadata": {
		"documentationUrl": "https://api.search.brave.com/app/documentation/web-search/get-started",
		"documentationStatus": "verified",
		"inputs": {
			"q": {
				"type": "string",
				"required": true
			},
			"count": {
				"type": "integer",
				"minimum": 1,
				"maximum": 20
			},
			"offset": {
				"type": "integer"
			},
			"country": {
				"type": "string"
			},
			"search_lang": {
				"type": "string"
			},
			"ui_lang": {
				"type": "string"
			},
			"freshness": {
				"type": "string"
			},
			"safesearch": {
				"type": "string"
			},
			"result_filter": {
				"type": "string"
			},
			"goggles": {
				"type": "array"
			}
		}
	}
}
