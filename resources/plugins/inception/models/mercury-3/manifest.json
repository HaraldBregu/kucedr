{
	"id": "mercury-3",
	"name": "Mercury 3",
	"type": "large-language-model",
	"authentication": "api-key",
	"url": "https://api.inceptionlabs.ai/v1",
	"metadata": {
		"protocol": "chat-completions",
		"clampEffort": true,
		"effort": {
			"path": "reasoning_effort"
		},
		"documentationUrl": "https://docs.inceptionlabs.ai/api-reference/chat/create-a-chat-completion",
		"documentationStatus": "verified",
		"contextWindow": 1000000,
		"contextWindowDocumentationUrl": "https://docs.inceptionlabs.ai/get-started/models",
		"inputs": {
			"reasoning_effort": {
				"type": "string",
				"enum": [
					"instant",
					"low",
					"medium",
					"high"
				],
				"default": "low"
			},
			"temperature": {
				"type": "number",
				"minimum": 0.5,
				"maximum": 1
			},
			"max_tokens": {
				"type": "integer",
				"minimum": 1,
				"maximum": 131072
			},
			"max_completion_tokens": {
				"type": "integer",
				"minimum": 1,
				"maximum": 131072
			},
			"stop": {
				"type": "array"
			},
			"tools": {
				"type": "array"
			},
			"tool_choice": {
				"type": "object"
			},
			"response_format": {
				"type": "object"
			},
			"stream": {
				"type": "boolean"
			},
			"stream_options": {
				"type": "object"
			},
			"realtime": {
				"type": "boolean"
			},
			"reasoning_summary": {
				"type": "boolean"
			},
			"reasoning_summary_wait": {
				"type": "boolean"
			}
		}
	},
	"location": "remote"
}
