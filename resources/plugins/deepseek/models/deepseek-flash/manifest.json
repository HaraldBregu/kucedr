				"mimeTypes": [
					"image/jpeg",
					"image/png",
					"image/gif",
					"image/webp"
				],
				"extensions": [
					".jpg",
					".jpeg",
					".png",
					".gif",
					".webp"
				],
				"maxFiles": 600,
				"maxBytes": 33554432,
				"maxTotalBytes": 37748736
			}
		],
		"documentationUrl": "https://api-docs.deepseek.com/news/news260910/",
		"documentationStatus": "verified",
		"contextWindow": 1048576,
		"defaultOutputTokens": 32768,
		"inputs": {
			"thinking": {
				"type": "object",
