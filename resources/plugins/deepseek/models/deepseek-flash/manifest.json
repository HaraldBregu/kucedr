					"none",
					"low",
					"high",
					"max"
				]
			},
			"max_tokens": {
				"type": "integer",
				"minimum": 1,
				"maximum": 393216
			},
			"temperature": {
				"type": "number",
				"minimum": 0,
				"maximum": 2,
				"default": 1
			},
			"top_p": {
				"type": "number",
				"maximum": 1
			},
			"top_k": {
				"type": "integer"
			},
			"frequency_penalty": {
				"type": "number"
			},
			"presence_penalty": {
				"type": "number"
			},
			"stop": {
				"type": "array"
			},
			"response_format": {
				"type": "object"
			},
			"tools": {
				"type": "array"
			},
			"tool_choice": {
				"type": "object"
			},
			"stream": {
				"type": "boolean"
			},
			"stream_options": {
				"type": "object"
			},
			"logprobs": {
				"type": "boolean"
			},
			"top_logprobs": {
				"type": "integer"
			},
			"user_id": {
				"type": "string"
			}
		},
