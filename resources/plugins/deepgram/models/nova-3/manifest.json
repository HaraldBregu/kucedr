{
	"id": "nova-3",
	"name": "Nova 3",
	"apiTypes": [
		"batch",
		"stream"
	],
	"type": "speech-to-text-model",
	"authentication": "api-key",
	"url": "https://api.deepgram.com/v1",
	"sampleRate": 24000,
	"metadata": {
		"protocol": "listen",
		"documentationUrl": "https://developers.deepgram.com/docs/model",
		"documentationStatus": "verified",
		"inputs": {
			"language": {
				"type": "string"
			},
			"smart_format": {
				"type": "boolean"
			},
			"punctuate": {
				"type": "boolean"
			},
			"utterances": {
				"type": "boolean"
			},
			"paragraphs": {
				"type": "boolean"
			},
			"diarize_model": {
				"type": "string",
				"enum": [
					"latest",
					"v1",
					"v2"
				]
			},
			"keyterm": {
				"type": "array"
			},
			"alternatives": {
				"type": "integer"
			},
			"detect_language": {
				"type": "boolean"
			}
		}
	},
	"location": "remote"
}
