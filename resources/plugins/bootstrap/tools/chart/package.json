{
	"name": "@kucedr-plugins/bootstrap-chart",
	"version": "1.0.0",
	"private": true,
	"type": "module",
	"description": "Bootstrap plugin tool that renders Recharts charts as self-contained HTML.",
	"scripts": {
		"build": "esbuild src/browser.jsx --bundle --minify --jsx=automatic --format=iife --outfile=dist/browser.js && esbuild src/index.mjs --bundle --platform=node --format=esm --outfile=dist/index.mjs"
	},
	"devDependencies": {
		"esbuild": "^0.28.2",
		"react": "^19.3.0",
		"react-dom": "^19.3.0",
		"react-is": "^19.3.0",
		"recharts": "^3.10.1"
	}
}
