{
	"title": "Cloud Sync S3",
	"description": "Back up selected folders to an Amazon S3 or S3-compatible bucket and restore them.",
	"author": "Harald Bregu",
	"metadata": {
		"version": "1.0.0",
		"category": "storage",
		"entry": "dist/index.mjs",
		"instructions": "instructions.md"
	},
	"inputSchema": {
		"type": "object",
		"required": ["operation", "provider", "roots", "protectedRoot"],
		"properties": {
			"operation": {
				"type": "string",
				"title": "Operation",
				"enum": ["backup", "restore"]
			},
			"provider": {
				"type": "object",
				"title": "Provider",
				"description": "S3 connection to the bucket.",
				"required": ["region", "bucket", "accessKeyId", "secretAccessKey"],
				"properties": {
					"protocol": { "type": "string", "enum": ["s3"], "default": "s3" },
					"endpoint": { "type": "string", "title": "Endpoint", "description": "Optional for Amazon S3; the service endpoint for other providers." },
					"region": { "type": "string", "title": "Region" },
					"bucket": { "type": "string", "title": "Bucket" },
					"forcePathStyle": { "type": "boolean", "default": false },
					"accessKeyId": { "type": "string", "title": "Access key ID" },
					"secretAccessKey": { "type": "string", "title": "Secret access key" }
				}
			},
			"roots": {
				"type": "array",
				"title": "Folders",
				"description": "Local folders to sync, each stored under its prefix.",
				"minItems": 1,
				"items": {
					"type": "object",
					"required": ["path", "prefix"],
					"properties": {
						"path": { "type": "string", "title": "Folder path" },
						"prefix": { "type": "string", "title": "Object prefix", "description": "The folder name followed by /." }
					}
				}
			},
			"protectedRoot": {
				"type": "string",
				"title": "Protected root",
				"description": "Kucedr data folder whose settings, providers and storage subfolders are never read or written."
			}
		}
	}
}
