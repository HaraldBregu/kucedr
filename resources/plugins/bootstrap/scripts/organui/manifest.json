{
	"title": "OrganUI",
	"description": "Render OrganUI clinical components: body map, dermatome map, patient banner, allergy and problem lists, vital signs, NEWS2 chart, lab results, medication schedule, ECG trace, growth chart, anatomy tree and medical image viewer, with an optional title. Not a medical device.",
	"author": "Harald Bregu",
	"type": "UI",
	"metadata": {
		"version": "1.0.0",
		"category": "data",
		"entry": "dist/index.mjs",
		"instructions": "instructions.md"
	},
	"inputSchema": {
		"type": "object",
		"required": [
			"component"
		],
		"properties": {
			"component": {
				"type": "string",
				"title": "Component",
				"enum": [
					"body-map",
					"dermatome-map",
					"patient-banner",
					"allergy-list",
					"problem-list",
					"vital-signs",
					"news2-chart",
					"lab-results",
					"medication-schedule",
					"ecg-trace",
					"growth-chart",
					"anatomy-tree",
					"image-viewer",
					"dna-helix",
					"ai-note",
					"clinical-sources",
					"clinical-citation",
					"differential-list",
					"clinician-review",
					"ai-disclaimer"
				]
			},
			"title": {
				"type": "string",
				"title": "Title"
			},
			"description": {
				"type": "string",
				"title": "Description"
			},
			"props": {
				"type": "object",
				"title": "Props",
				"description": "The component's props. Use only real clinical data."
			}
		},
