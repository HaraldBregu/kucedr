				"extensions": [
					".jpg",
					".jpeg",
					".png",
					".gif",
					".webp"
				]
			},
			{
				"kind": "document",
				"mimeTypes": [
					"application/pdf"
				],
				"extensions": [
					".pdf"
				]
			}
		],
