{
	"id": "claude-sonnet-4-6",
	"name": "Claude Sonnet 4.6",
	"type": "large-language-model",
	"authentication": "api-key",
	"url": "https://api.anthropic.com",
	"metadata": {
		"clampEffort": true,
		"cache": {
			"breakpoints": [
				"system"
			]
		},
		"promptAttachments": [
			{
				"kind": "image",
				"mimeTypes": [
					"image/jpeg",
					"image/png",
					"image/gif",
					"image/webp"
				],
				"extensions": [
					".jpg",
					".jpeg",
					".png",
					".gif",
					".webp"
				],
				"maxFiles": 600,
				"maxBytes": 7864320,
				"maxTotalBytes": 100663296
			},
			{
				"kind": "document",
				"mimeTypes": [
					"application/pdf"
				],
				"extensions": [
					".pdf"
				],
				"maxTotalBytes": 100663296
			}
		],
		"documentationUrl": "https://platform.claude.com/docs/en/api/messages",
		"documentationStatus": "verified",
		"inputs": {
			"max_tokens": {
				"type": "integer",
				"minimum": 1,
				"required": true
			},
			"temperature": {
				"type": "number",
				"minimum": 0,
				"maximum": 1
			},
			"top_p": {
				"type": "number",
				"minimum": 0,
				"maximum": 1
			},
			"top_k": {
				"type": "integer",
				"minimum": 1
			},
			"stop_sequences": {
				"type": "array"
			},
			"thinking": {
				"type": "object",
				"properties": {
					"type": {
						"type": "string",
						"enum": [
							"adaptive",
							"enabled",
							"disabled"
						]
					},
					"budget_tokens": {
						"type": "integer",
						"minimum": 1024
					}
				}
			},
			"output_config": {
				"type": "object",
				"properties": {
					"effort": {
						"type": "string",
						"enum": [
							"low",
							"medium",
							"high",
							"max"
						]
					}
				}
			},
			"tools": {
				"type": "array"
			},
			"tool_choice": {
				"type": "object"
			},
			"metadata": {
				"type": "object"
			}
		},
		"contextWindow": 1000000,
		"contextWindowDocumentationUrl": "https://platform.claude.com/docs/en/models/sonnet-4-6/overview"
	},
	"location": "remote"
}
