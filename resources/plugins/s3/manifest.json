{
	"schemaVersion": 5,
	"id": "s3",
	"title": "S3",
	"version": "1.0.0",
	"description": "Amazon S3 or any S3-compatible bucket for folder backups.",
	"categories": [
		"STORAGE"
	],
	"author": "Harald Bregu",
	"website": "https://aws.amazon.com/s3/",
	"settings": {
		"inputSchema": {
			"type": "object",
			"properties": {
				"bucket": { "type": "string", "title": "Bucket" },
				"region": { "type": "string", "title": "Region" },
				"endpoint": { "type": "string", "title": "Endpoint", "description": "Optional for Amazon S3; the service endpoint for other providers." },
				"forcePathStyle": { "type": "string", "title": "Path-style URLs", "description": "true or false." },
				"accessKeyId": { "type": "string", "title": "Access key ID" },
				"secretAccessKey": { "type": "string", "title": "Secret access key", "format": "password" }
			},
			"required": ["bucket", "region", "accessKeyId", "secretAccessKey"]
		}
	}
}
