{
	"id": "eleven-music",
	"name": "Eleven Music",
	"type": "text-to-audio-model",
	"authentication": "api-key",
	"url": "https://api.elevenlabs.io/v1",
	"metadata": {
		"protocol": "music",
		"apiModelId": "music_v1",
		"documentationUrl": "https://elevenlabs.io/docs/api-reference/music/compose",
		"documentationStatus": "verified",
		"inputs": {
			"music_length_ms": {
				"type": "integer",
				"minimum": 3000,
				"maximum": 600000,
				"description": "Chosen from the prompt when omitted."
			},
			"force_instrumental": {
				"type": "boolean",
				"default": false
			},
			"output_format": {
				"type": "string",
				"default": "auto",
				"description": "auto uses mp3_44100_128 for v1 and mp3_48000_192 for v2 models.",
				"enum": [
					"auto",
					"mp3_48000_128",
					"mp3_48000_192",
					"mp3_48000_240",
					"mp3_48000_320",
					"mp3_22050_32",
					"mp3_24000_48",
					"mp3_44100_32",
					"mp3_44100_64",
					"mp3_44100_96",
					"mp3_44100_128",
					"mp3_44100_192",
					"pcm_8000",
					"pcm_16000",
					"pcm_22050",
					"pcm_24000",
					"pcm_32000",
					"pcm_44100",
					"pcm_48000",
					"ulaw_8000",
					"alaw_8000",
					"opus_48000_32",
					"opus_48000_64",
					"opus_48000_96",
					"opus_48000_128",
					"opus_48000_192"
				]
			},
			"enable_logging": {
				"type": "boolean",
				"default": true,
				"description": "false enables zero retention mode, available to enterprise customers only."
			},
			"finetune_id": {
				"type": "string"
			},
			"store_for_inpainting": {
				"type": "boolean",
				"default": false
			},
			"sign_with_c2pa": {
				"type": "boolean",
				"default": false,
				"description": "MP3 output only."
			}
		}
	},
	"location": "remote"
}
