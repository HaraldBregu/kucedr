{
	"id": "eleven_text_to_sound_v2",
	"name": "Eleven Sound Effects v2",
	"type": "text-to-audio-model",
	"authentication": "api-key",
	"url": "https://api.elevenlabs.io/v1",
	"metadata": {
		"documentationUrl": "https://elevenlabs.io/docs/api-reference/text-to-sound-effects/convert",
		"documentationStatus": "verified",
		"inputs": {
			"duration_seconds": {
				"type": "number",
				"minimum": 0.5,
				"maximum": 30,
				"description": "Inferred from the prompt when omitted."
			},
			"prompt_influence": {
				"type": "number",
				"minimum": 0,
				"maximum": 1,
				"default": 0.3,
				"description": "Higher values follow the prompt more closely."
			},
			"loop": {
				"type": "boolean",
				"default": false
			},
			"output_format": {
				"type": "string",
				"default": "mp3_44100_128",
				"description": "MP3 at 192 kbps requires Creator tier or above; PCM and WAV at 44.1 kHz require Pro tier or above.",
				"enum": [
					"alaw_8000",
					"mp3_22050_32",
					"mp3_24000_48",
					"mp3_44100_32",
					"mp3_44100_64",
					"mp3_44100_96",
					"mp3_44100_128",
					"mp3_44100_192",
					"opus_48000_32",
					"opus_48000_64",
					"opus_48000_96",
					"opus_48000_128",
					"opus_48000_192",
					"pcm_8000",
					"pcm_16000",
					"pcm_22050",
					"pcm_24000",
					"pcm_32000",
					"pcm_44100",
					"pcm_48000",
					"ulaw_8000",
					"wav_8000",
					"wav_16000",
					"wav_22050",
					"wav_24000",
					"wav_32000",
					"wav_44100",
					"wav_48000"
				]
			},
			"enable_logging": {
				"type": "boolean",
				"default": true,
				"description": "false enables zero retention mode, available to enterprise customers only."
			}
		}
	},
	"location": "remote"
}
