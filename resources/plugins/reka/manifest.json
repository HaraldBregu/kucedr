{
	"schemaVersion": 5,
	"id": "reka",
	"title": "Reka AI",
	"version": "1.0.0",
	"description": "Reka multimodal chat models.",
	"categories": [
		"LLM"
	],
	"author": "Kucedr",
	"icon": "reka-light.svg",
	"iconDark": "reka-dark.svg",
	"authentication": "api-key",
	"apiKeyUrl": "https://platform.reka.ai/apikeys",
	"icon_dark_url": "/assets/reka-dark.svg",
	"icon_light_url": "/assets/reka-light.svg",
	"models": [
		{
			"id": "reka-flash",
			"name": "Reka Flash",
			"authentication": "api-key",
			"type": "large-language-model",
			"url": "https://api.reka.ai/v1",
			"metadata": {
				"promptAttachments": [
					{
						"kind": "image",
						"mimeTypes": [
							"image/jpeg",
							"image/png",
							"image/webp"
						],
						"extensions": [
							".jpg",
							".jpeg",
							".png",
							".webp"
						]
					},
					{
						"kind": "document",
						"mimeTypes": [
							"application/pdf"
						],
						"extensions": [
							".pdf"
						]
					}
				],
				"documentationUrl": "https://docs.reka.ai/chat/models",
				"documentationStatus": "verified",
				"inputs": {
					"temperature": {
						"type": "number"
					},
					"top_p": {
						"type": "number"
					},
					"max_tokens": {
						"type": "integer"
					},
					"stop": {
						"type": "array"
					},
					"stream": {
						"type": "boolean"
					},
					"response_format": {
						"type": "object"
					},
					"tools": {
						"type": "array"
					}
				},
				"contextWindow": 128000,
				"contextWindowDocumentationUrl": "https://reka.ai/news/reka-flash-updates"
			},
			"location": "remote"
		},
		{
			"id": "reka-edge-2603",
			"name": "Reka Edge 2603",
			"authentication": "api-key",
			"type": "large-language-model",
			"url": "https://api.reka.ai/v1",
			"metadata": {
				"promptAttachments": [
					{
						"kind": "image",
						"mimeTypes": [
							"image/jpeg",
							"image/png",
							"image/webp"
						],
						"extensions": [
							".jpg",
							".jpeg",
							".png",
							".webp"
						]
					},
					{
						"kind": "document",
						"mimeTypes": [
							"application/pdf"
						],
						"extensions": [
							".pdf"
						]
					}
				],
				"documentationUrl": "https://docs.reka.ai/chat/models",
				"documentationStatus": "verified",
				"inputs": {
					"temperature": {
						"type": "number"
					},
					"top_p": {
						"type": "number"
					},
					"max_tokens": {
						"type": "integer"
					},
					"stop": {
						"type": "array"
					},
					"stream": {
						"type": "boolean"
					},
					"response_format": {
						"type": "object"
					},
					"tools": {
						"type": "array"
					}
				},
				"contextWindow": 16384,
				"contextWindowDocumentationUrl": "https://huggingface.co/RekaAI/reka-edge-2603/raw/main/config.json"
			},
			"location": "remote"
		}
	]
}
