{
	"id": "kimi-k2.7-code-highspeed",
	"name": "Kimi K2.7 Code Highspeed",
	"type": "large-language-model",
	"authentication": "api-key",
	"url": "https://api.moonshot.ai/v1",
	"metadata": {
		"protocol": "chat-completions",
		"reasoningContent": "roundtrip",
		"outputTokensField": "max_completion_tokens",
		"defaultOutputTokens": 32768,
		"promptAttachments": [
			{
				"kind": "image",
				"mimeTypes": [
					"image/jpeg",
					"image/png",
					"image/webp"
				],
				"extensions": [
					".jpg",
					".jpeg",
					".png",
					".webp"
				]
			}
		],
		"documentationUrl": "https://platform.kimi.ai/docs/api/chat",
		"documentationStatus": "verified",
		"inputs": {
			"thinking": {
				"type": "object",
				"properties": {
					"type": {
						"type": "string",
						"enum": [
							"enabled"
						]
					}
				}
			},
			"max_completion_tokens": {
				"type": "integer"
			},
			"stop": {
				"type": "array",
				"maxItems": 5
			},
			"response_format": {
				"type": "object"
			},
			"tools": {
				"type": "array"
			},
			"tool_choice": {
				"type": "object"
			},
			"stream": {
				"type": "boolean"
			},
			"stream_options": {
				"type": "object"
			},
			"logprobs": {
				"type": "boolean"
			},
			"top_logprobs": {
				"type": "integer",
				"minimum": 0,
				"maximum": 20
			},
			"prompt_cache_key": {
				"type": "string"
			},
			"safety_identifier": {
				"type": "string"
			}
		},
		"contextWindow": 262144,
		"contextWindowDocumentationUrl": "https://platform.kimi.ai/docs/api/models-overview"
	},
	"location": "remote"
}
