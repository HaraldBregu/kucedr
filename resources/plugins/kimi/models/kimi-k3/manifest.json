{
	"id": "kimi-k3",
	"name": "Kimi K3",
	"type": "large-language-model",
	"authentication": "api-key",
	"url": "https://api.moonshot.ai/v1",
	"metadata": {
		"protocol": "chat-completions",
		"effort": {
			"path": "reasoning_effort"
		},
		"clampEffort": true,
		"reasoningContent": "roundtrip",
		"outputTokensField": "max_completion_tokens",
		"promptAttachments": [
			{
				"kind": "image",
				"mimeTypes": [
					"image/jpeg",
					"image/png",
					"image/gif",
					"image/webp",
					"image/bmp",
					"image/heic",
					"image/heif"
				],
				"extensions": [
					".jpg",
					".jpeg",
					".png",
					".gif",
					".webp",
					".bmp",
					".heic",
					".heif"
				]
			}
		],
		"documentationUrl": "https://platform.kimi.ai/docs/api/chat",
		"documentationStatus": "verified",
		"inputs": {
			"reasoning_effort": {
				"type": "string",
				"default": "max",
				"enum": [
					"low",
					"high",
					"max"
				]
			},
			"max_completion_tokens": {
				"type": "integer",
				"default": 131072,
				"maximum": 1048576
			},
			"stop": {
				"type": "array",
				"maxItems": 5
			},
			"response_format": {
				"type": "object"
			},
			"tools": {
				"type": "array"
			},
			"tool_choice": {
				"type": "object"
			},
			"stream": {
				"type": "boolean"
			},
			"stream_options": {
				"type": "object"
			},
			"logprobs": {
				"type": "boolean"
			},
			"top_logprobs": {
				"type": "integer",
				"minimum": 0,
				"maximum": 20
			},
			"prompt_cache_key": {
				"type": "string"
			},
			"safety_identifier": {
				"type": "string"
			}
		},
		"contextWindow": 1048576,
		"contextWindowDocumentationUrl": "https://platform.kimi.ai/docs/api/models-overview"
	},
	"location": "remote"
}
