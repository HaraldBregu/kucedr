	"icon_dark_url": "/assets/kimi.svg",
	"icon_light_url": "/assets/kimi.svg",
	"models": [
		{
			"id": "kimi-k3",
			"name": "Kimi K3",
			"type": "large-language-model",
			"authentication": "api-key",
			"url": "https://api.moonshot.ai/v1",
			"metadata": {
				"promptAttachments": [
					{
						"kind": "image",
						"mimeTypes": [
							"image/jpeg",
							"image/png",
							"image/webp"
						],
						"extensions": [
							".jpg",
							".jpeg",
							".png",
							".webp"
						]
					}
				],
				"documentationUrl": "https://platform.kimi.ai/docs/api/chat",
				"documentationStatus": "verified",
				"inputs": {
					"reasoning_effort": {
						"type": "string",
						"enum": [
							"low",
							"high",
							"max"
						]
					},
					"temperature": {
						"type": "number"
					},
					"top_p": {
						"type": "number"
					},
					"max_tokens": {
						"type": "integer"
					},
					"stop": {
						"type": "array"
					},
					"n": {
						"type": "integer"
					},
					"presence_penalty": {
						"type": "number"
					},
					"frequency_penalty": {
						"type": "number"
					},
					"response_format": {
						"type": "object"
					},
					"tools": {
						"type": "array"
					},
					"tool_choice": {
						"type": "object"
					},
					"parallel_tool_calls": {
						"type": "boolean"
					},
					"stream": {
						"type": "boolean"
					},
					"stream_options": {
						"type": "object"
					},
					"user": {
						"type": "string"
					}
				},
				"contextWindow": 1048576,
				"contextWindowDocumentationUrl": "https://huggingface.co/moonshotai/Kimi-K3/raw/main/config.json"
			},
			"location": "remote"
		},
