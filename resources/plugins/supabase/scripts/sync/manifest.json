{
	"title": "Sync",
	"description": "Back up selected folders to the Supabase Storage bucket and restore them, through its S3 endpoint.",
	"author": "Harald Bregu",
	"metadata": {
		"version": "1.0.0",
		"category": "storage",
		"entry": "dist/index.mjs",
		"instructions": "instructions.md"
	},
	"storage": {
		"id": "supabase-storage",
		"name": "Supabase Storage",
		"description": "Store files in a Supabase Storage bucket through its S3 endpoint.",
		"authentication": "s3-access-key",
		"metadata": {
			"protocol": "s3",
			"endpointTemplate": "https://{projectRef}.storage.supabase.co/storage/v1/s3",
			"forcePathStyle": true
		}
	},
	"inputSchema": {
		"type": "object",
		"required": ["operation", "provider", "roots", "protectedRoot"],
		"properties": {
			"operation": {
				"type": "string",
				"title": "Operation",
				"enum": ["backup", "restore"]
			},
			"provider": {
				"type": "object",
				"title": "Provider",
				"description": "S3 connection to the Supabase Storage bucket.",
				"required": ["region", "endpoint", "bucket", "accessKeyId", "secretAccessKey"],
				"properties": {
					"protocol": { "type": "string", "enum": ["s3"], "default": "s3" },
					"endpoint": { "type": "string", "title": "Endpoint", "description": "https://{projectRef}.storage.supabase.co/storage/v1/s3" },
					"region": { "type": "string", "title": "Region" },
					"bucket": { "type": "string", "title": "Bucket" },
					"forcePathStyle": { "type": "boolean", "default": true },
					"accessKeyId": { "type": "string", "title": "Access key ID" },
					"secretAccessKey": { "type": "string", "title": "Secret access key" }
				}
			},
			"roots": {
				"type": "array",
				"title": "Folders",
				"description": "Local folders to sync, each stored under its prefix.",
				"minItems": 1,
				"items": {
					"type": "object",
					"required": ["path", "prefix"],
					"properties": {
						"path": { "type": "string", "title": "Folder path" },
						"prefix": { "type": "string", "title": "Object prefix", "description": "The folder name followed by /." }
					}
				}
			},
			"protectedRoot": {
				"type": "string",
				"title": "Protected root",
				"description": "Kucedr data folder whose settings, providers and storage subfolders are never read or written."
			}
		}
	}
}
