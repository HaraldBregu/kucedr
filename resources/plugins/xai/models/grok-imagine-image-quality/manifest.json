{
	"id": "grok-imagine-image-quality",
	"name": "Grok Imagine Image Quality",
	"authentication": "api-key",
	"type": "text-to-image-model",
	"url": "https://api.x.ai/v1",
	"metadata": {
		"documentationUrl": "https://docs.x.ai/developers/models",
		"documentationStatus": "verified",
		"inputs": {
			"n": {
				"type": "integer",
				"maximum": 10
			},
			"aspect_ratio": {
				"type": "string",
				"default": "auto",
				"enum": [
					"auto",
					"1:1",
					"16:9",
					"9:16",
					"4:3",
					"3:4",
					"3:2",
					"2:3",
					"2:1",
					"1:2",
					"19.5:9",
					"9:19.5",
					"20:9",
					"9:20",
					"21:9",
					"5:2"
				]
			},
			"resolution": {
				"type": "string",
				"default": "1k",
				"enum": [
					"1k",
					"2k"
				]
			},
			"response_format": {
				"type": "string",
				"default": "url",
				"enum": [
					"url",
					"b64_json"
				]
			},
			"storage_options": {
				"type": "object",
				"description": "Also store the generated file in xAI file storage.",
				"properties": {
					"filename": {
						"type": "string",
						"required": true
					},
					"expires_after": {
						"type": "integer",
						"minimum": 1,
						"maximum": 2592000,
						"description": "Seconds until the stored file expires. Never expires when omitted."
					},
					"public_url": {
						"type": "boolean",
						"description": "Return a public URL for the stored file."
					}
				}
			}
		}
	},
	"location": "remote"
}
