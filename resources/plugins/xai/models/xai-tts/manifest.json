{
	"id": "xai-tts",
	"name": "Grok Text to Speech",
	"authentication": "api-key",
	"type": "text-to-speech-model",
	"url": "https://api.x.ai/v1",
	"metadata": {
		"documentationUrl": "https://docs.x.ai/developers/model-capabilities/audio/text-to-speech",
		"documentationStatus": "verified",
		"inputs": {
			"voice_id": {
				"type": "string",
				"title": "Voice",
				"default": "eve",
				"oneOf": [
					{ "const": "eve", "title": "Eve" },
					{ "const": "ara", "title": "Ara" },
					{ "const": "rex", "title": "Rex" },
					{ "const": "sal", "title": "Sal" },
					{ "const": "leo", "title": "Leo" }
				]
			},
			"language": {
				"type": "string",
				"default": "auto",
				"enum": [
					"auto",
					"en",
					"ar-EG",
					"ar-SA",
					"ar-AE",
					"bn",
					"zh",
					"fr",
					"de",
					"hi",
					"id",
					"it",
					"ja",
					"ko",
					"pt-BR",
					"pt-PT",
					"ru",
					"es-MX",
					"es-ES",
					"tr",
					"vi"
				]
			},
			"speed": {
				"type": "number",
				"minimum": 0.7,
				"maximum": 1.5,
				"default": 1
			},
			"optimize_streaming_latency": {
				"type": "integer",
				"default": 0,
				"enum": [
					0,
					1,
					2
				]
			},
			"output_format": {
				"type": "object",
				"properties": {
					"codec": {
						"type": "string",
						"enum": [
							"mp3",
							"wav",
							"pcm",
							"mulaw",
							"alaw"
						]
					},
					"sample_rate": {
						"type": "integer",
						"enum": [
							8000,
							16000,
							22050,
							24000,
							44100,
							48000
						]
					},
					"bit_rate": {
						"type": "integer",
						"enum": [
							32000,
							64000,
							96000,
							128000,
							192000
						]
					}
				}
			},
			"text_normalization": {
				"type": "boolean"
			},
			"replace": {
				"type": "object"
			}
		},
		"defaultVoice": "eve"
	},
	"location": "remote"
}
