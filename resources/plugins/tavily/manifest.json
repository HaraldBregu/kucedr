{
	"schemaVersion": 5,
	"id": "tavily",
	"title": "Tavily",
	"version": "1.0.0",
	"description": "Tavily provider for Kucedr.",
	"author": "Kucedr",
	"icon": "tavily.svg",
	"authentication": "api-key",
	"apiKeyUrl": "https://app.tavily.com/home",
	"icon_dark_url": "/assets/tavily.svg",
	"icon_light_url": "/assets/tavily.svg",
	"web_search": [
		{
			"id": "tavily-web-search",
			"name": "Tavily Web Search",
			"url": "https://api.tavily.com/search",
			"authentication": "api-key",
			"metadata": {
				"documentationUrl": "https://docs.tavily.com/documentation/api-reference/endpoint/search",
				"documentationStatus": "verified",
				"inputs": {
					"search_depth": {
						"type": "string",
						"enum": [
							"basic",
							"advanced",
							"fast",
							"ultra-fast"
						]
					},
					"chunks_per_source": {
						"type": "integer",
						"minimum": 1,
						"maximum": 3
					},
					"topic": {
						"type": "string",
						"enum": [
							"general",
							"news",
							"finance"
						]
					},
					"time_range": {
						"type": "string"
					},
					"start_date": {
						"type": "string"
					},
					"end_date": {
						"type": "string"
					},
					"include_answer": {
						"type": "boolean"
					},
					"include_raw_content": {
						"type": "boolean"
					},
					"include_images": {
						"type": "boolean"
					},
					"include_domains": {
						"type": "array"
					},
					"exclude_domains": {
						"type": "array"
					},
					"max_results": {
						"type": "integer"
					},
					"country": {
						"type": "string"
					},
					"auto_parameters": {
						"type": "boolean"
					}
				}
			}
		}
	]
}
