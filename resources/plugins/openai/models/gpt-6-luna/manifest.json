				"extensions": [
					".jpg",
					".jpeg",
					".png",
					".webp"
				]
			},
			{
				"kind": "document",
				"mimeTypes": [
					"application/pdf"
				],
				"extensions": [
					".pdf"
				]
			}
		],
		"documentationUrl": "https://developers.openai.com/api/docs/models/gpt-6-luna",
		"documentationStatus": "verified",
		"inputs": {
			"reasoning": {
				"type": "object",
