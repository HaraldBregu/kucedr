{
	"id": "gpt-image-2.5-sunburst",
	"name": "GPT Image 2.5 Sunburst",
	"type": "text-to-image-model",
	"authentication": "api-key",
	"url": "https://api.openai.com/v1",
	"location": "remote",
	"metadata": {
		"protocol": "images",
		"documentationUrl": "https://developers.openai.com/api/docs/guides/image-generation",
		"documentationStatus": "verified",
		"inputs": {
			"size": {
				"type": "string",
				"title": "Aspect ratio",
				"default": "auto",
				"description": "WIDTHxHEIGHT or auto; multiples of 16, aspect ratio 1:3 to 3:1, edges at most 3840, 655360 to 8294400 pixels.",
				"oneOf": [
					{
						"const": "auto",
						"title": "Auto"
					},
					{
						"const": "1024x1024",
						"title": "1:1"
					},
					{
						"const": "1536x1024",
						"title": "3:2"
					},
					{
						"const": "1024x1536",
						"title": "2:3"
					},
					{
						"const": "1408x1056",
						"title": "4:3"
					},
					{
						"const": "1056x1408",
						"title": "3:4"
					},
					{
						"const": "1536x864",
						"title": "16:9"
					},
					{
						"const": "864x1536",
						"title": "9:16"
					},
					{
						"const": "1792x768",
						"title": "21:9"
					},
					{
						"const": "768x1792",
						"title": "9:21"
					},
					{
						"const": "1280x1024",
						"title": "5:4"
					},
					{
						"const": "1024x1280",
						"title": "4:5"
					},
					{
						"const": "1536x768",
						"title": "2:1"
					},
					{
						"const": "768x1536",
						"title": "1:2"
					},
					{
						"const": "1600x640",
						"title": "5:2"
					},
					{
						"const": "640x1600",
						"title": "2:5"
					},
					{
						"const": "1536x512",
						"title": "3:1"
					},
					{
						"const": "512x1536",
						"title": "1:3"
					}
				]
			},
			"quality": {
				"type": "string",
				"enum": [
					"low",
					"medium",
					"high",
					"xhigh",
					"max",
					"auto"
				],
				"default": "auto"
			},
			"background": {
				"type": "string",
				"enum": [
					"auto",
					"opaque",
					"transparent"
				],
				"default": "auto"
			},
			"output_format": {
				"type": "string",
				"enum": [
					"png",
					"jpeg",
					"webp"
				],
				"default": "png"
			},
			"output_compression": {
				"type": "integer",
				"minimum": 0,
				"maximum": 100
			},
			"moderation": {
				"type": "string",
				"enum": [
					"auto",
					"low"
				],
				"default": "auto"
			}
		},
		"promptAttachments": [
			{
				"kind": "image",
				"mimeTypes": [
					"image/png",
					"image/jpeg",
					"image/webp"
				],
				"extensions": [
					".png",
					".jpg",
					".jpeg",
					".webp"
				]
			}
		]
	}
}
