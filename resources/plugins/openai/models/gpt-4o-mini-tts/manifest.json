{
	"id": "gpt-4o-mini-tts",
	"name": "GPT-4o Mini TTS",
	"type": "text-to-speech-model",
	"authentication": "api-key",
	"url": "https://api.openai.com/v1",
	"metadata": {
		"protocol": "audio-speech",
		"documentationUrl": "https://platform.openai.com/docs/api-reference",
		"documentationStatus": "verified",
		"inputs": {
			"voice": {
				"type": "string",
				"title": "Voice",
				"default": "alloy",
				"oneOf": [
					{ "const": "alloy", "title": "Alloy" },
					{ "const": "ash", "title": "Ash" },
					{ "const": "ballad", "title": "Ballad" },
					{ "const": "coral", "title": "Coral" },
					{ "const": "echo", "title": "Echo" },
					{ "const": "fable", "title": "Fable" },
					{ "const": "onyx", "title": "Onyx" },
					{ "const": "nova", "title": "Nova" },
					{ "const": "sage", "title": "Sage" },
					{ "const": "shimmer", "title": "Shimmer" },
					{ "const": "verse", "title": "Verse" },
					{ "const": "marin", "title": "Marin" },
					{ "const": "cedar", "title": "Cedar" }
				]
			},
			"custom_voice_id": {
				"type": "string",
				"title": "Custom voice ID"
			},
			"instructions": {
				"type": "string"
			},
			"response_format": {
				"type": "string",
				"default": "mp3",
				"enum": [
					"mp3",
					"opus",
					"aac",
					"flac",
					"wav",
					"pcm"
				]
			},
			"speed": {
				"type": "number",
				"minimum": 0.25,
				"maximum": 4,
				"default": 1
			}
		}
	},
	"location": "remote"
}
