{
	"name": "kucedr-videomaker",
	"private": true,
	"version": "1.0.0",
	"description": "A Remotion-powered video editor for Kucedr.",
	"keywords": [
		"creative"
	],
	"main": "dist/index.html",
	"files": [
		"dist",
		"manifest.json"
	],
	"type": "module",
	"scripts": {
		"dev": "vite",
		"typecheck": "tsc --noEmit",
		"build": "npm run typecheck && vite build",
		"prepack": "npm run build",
		"preview": "vite preview"
	},
	"dependencies": {
		"@kucedr/sdk": "file:../../../packages/sdk",
		"@remotion/media": "4.0.520",
		"@remotion/player": "4.0.513",
		"@remotion/web-renderer": "4.0.520",
		"lucide-react": "^1.39.0",
		"mediabunny": "1.56.0",
		"react": "^19.2.0",
		"react-dom": "^19.2.0",
		"remotion": "4.0.520"
	},
	"devDependencies": {
		"@types/react": "^19.2.18",
		"@types/react-dom": "^19.2.5",
		"@vitejs/plugin-react": "^6.1.1",
		"typescript": "^5.9.2",
		"vite": "^8.2.2"
	}
}
