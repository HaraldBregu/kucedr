        "inputs": {
          "language_code": {
            "type": "string"
          },
          "commit_strategy": {
            "type": "string"
          },
          "vad_silence_threshold_secs": {
            "type": "number"
          }
        }
      }
    },
    {
      "id": "eleven_v3",
      "name": "Eleven v3",
      "type": "text-to-speech-model",
      "url": "https://api.elevenlabs.io/v1",
      "default": true,
      "metadata": {
        "documentationUrl": "https://elevenlabs.io/docs/api-reference/text-to-speech/convert",
        "documentationStatus": "verified",
        "inputs": {
          "voice_id": {
            "type": "string",
            "title": "Voice ID",
            "default": "21m00Tcm4TlvDq8ikWAM",
            "required": true
          },
          "language_code": {
            "type": "string"
          },
          "voice_settings": {
            "type": "object",
            "properties": {
              "stability": {
                "type": "number",
                "minimum": 0,
                "maximum": 1,
                "default": 0.5
              },
              "similarity_boost": {
                "type": "number",
                "minimum": 0,
                "maximum": 1,
                "default": 0.75
              },
              "style": {
                "type": "number",
                "default": 0
              },
              "use_speaker_boost": {
                "type": "boolean",
                "default": true
              },
              "speed": {
                "type": "number",
                "minimum": 0.7,
                "maximum": 1.2,
                "default": 1
              }
            }
          },
          "output_format": {
            "type": "string",
            "default": "mp3_44100_128"
          },
          "enable_logging": {
            "type": "boolean",
            "default": true
          },
          "optimize_streaming_latency": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4
          },
          "seed": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4294967295
          },
          "pronunciation_dictionary_locators": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "pronunciation_dictionary_id": {
                  "type": "string"
                },
                "version_id": {
                  "type": "string"
                }
              }
            }
          },
          "previous_text": {
            "type": "string"
          },
          "next_text": {
            "type": "string"
          },
          "previous_request_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "next_request_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "apply_text_normalization": {
            "type": "string",
            "default": "auto",
            "enum": ["auto", "on", "off"]
          },
          "apply_language_text_normalization": {
            "type": "boolean",
            "default": false
          },
          "use_pvc_as_ivc": {
            "type": "boolean",
            "default": false
          }
        }
      }
    },
