    {
      "id": "scribe_v2",
      "name": "Scribe v2",
      "apiTypes": [
        "batch"
      ],
      "type": "speech-to-text-model",
      "url": "https://api.elevenlabs.io/v1",
      "sampleRate": 16000,
      "metadata": {
        "documentationUrl": "https://elevenlabs.io/docs/api-reference",
        "documentationStatus": "verified",
        "inputs": {
          "language_code": {
            "type": "string"
          },
          "tag_audio_events": {
            "type": "boolean"
          },
          "diarize": {
            "type": "boolean"
          },
          "additional_formats": {
            "type": "array"
          },
          "timestamps_granularity": {
            "type": "string"
          }
        }
      }
    },
    {
      "id": "scribe_v2_realtime",
      "name": "Scribe v2 Realtime",
      "apiTypes": [
        "stream"
      ],
      "realtime": true,
      "type": "speech-to-text-model",
      "url": "https://api.elevenlabs.io/v1",
