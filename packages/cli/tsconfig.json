{
	"compilerOptions": {
		"target": "ES2022",
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"lib": ["ES2022"],
		"strict": true,
		"skipLibCheck": true,
		"verbatimModuleSyntax": true,
		"declaration": true,
		"rootDir": "src",
		"outDir": "dist",
		"jsx": "react-jsx"
		,"types": ["node"]
	},
	"include": ["src"]
}
