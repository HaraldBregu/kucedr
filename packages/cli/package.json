{
	"name": "@kucedr/cli",
	"version": "0.1.0",
	"description": "Command-line and terminal interface for Kucedr",
	"type": "module",
	"bin": {
		"kucedr": "./dist/bin.js"
	},
	"main": "./dist/bin.js",
	"types": "./dist/bin.d.ts",
	"files": [
		"dist",
		"README.md",
		"LICENSE"
	],
	"engines": {
		"node": ">=22.12"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/HaraldBregu/kucedr.git",
		"directory": "packages/cli"
	},
	"homepage": "https://github.com/HaraldBregu/kucedr/tree/main/packages/cli#readme",
	"bugs": {
		"url": "https://github.com/HaraldBregu/kucedr/issues"
	},
	"scripts": {
		"clean": "rimraf dist",
		"build": "npm run clean && tsc -p tsconfig.json",
		"typecheck": "tsc --noEmit -p tsconfig.json",
		"test": "tsc -p tsconfig.test.json && node --test .test-dist/tests/data.test.js .test-dist/tests/fetch.test.js .test-dist/tests/install.test.js .test-dist/tests/launch.test.js .test-dist/tests/parse.test.js .test-dist/tests/program.test.js",
		"prepack": "npm run build"
	},
	"dependencies": {
		"commander": "^15.0.0",
		"ink": "^7.1.1",
		"ink-text-input": "^6.0.0",
		"react": "^19.2.0",
		"tar": "^7.5.22",
		"zod": "^4.6.5"
	},
	"devDependencies": {
		"@types/node": "^26.1.2",
		"@types/react": "^19.2.0",
		"rimraf": "^6.0.1",
		"typescript": "^7.0.2"
	},
	"publishConfig": {
		"access": "public",
		"registry": "https://registry.npmjs.org/"
	},
	"keywords": [
		"kucedr",
		"cli",
		"tui",
		"plugins"
	],
	"author": "Harald Bregu <harald.bregu@gmail.com>",
	"license": "MIT"
}
