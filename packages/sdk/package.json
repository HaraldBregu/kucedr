{
	"name": "@kucedr/sdk",
	"version": "0.1.0",
	"description": "Typed client for the Kucedr desktop app API",
	"type": "module",
	"main": "./dist/packages/sdk/index.js",
	"types": "./dist/packages/sdk/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/packages/sdk/index.d.ts",
			"default": "./dist/packages/sdk/index.js"
		}
	},
	"files": [
		"dist"
	],
	"engines": {
		"node": ">=18"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/HaraldBregu/kucedr.git",
		"directory": "packages/sdk"
	},
	"homepage": "https://github.com/HaraldBregu/kucedr/tree/main/packages/sdk#readme",
	"bugs": {
		"url": "https://github.com/HaraldBregu/kucedr/issues"
	},
	"scripts": {
		"clean": "rimraf dist",
		"build": "npm run clean && tsc -p tsconfig.json && node postbuild.js",
		"typecheck": "tsc --noEmit -p tsconfig.json",
		"test": "npm run smoke",
		"smoke": "npm run build && node smoke.js",
		"prepack": "npm run build"
	},
	"publishConfig": {
		"access": "public",
		"registry": "https://registry.npmjs.org/"
	},
	"devDependencies": {
		"rimraf": "^6.1.4",
		"typescript": "^7.0.2"
	},
	"keywords": [
		"kucedr",
		"sdk"
	],
	"author": "Harald Bregu <harald.bregu@gmail.com>",
	"license": "MIT"
}
