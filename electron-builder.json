{
	"productName": "Kucedr",
	"appId": "com.kucedr.kucedr",
	"copyright": "© 2026 Kucedr Project. All rights reserved.",
	"files": [
		"out/**",
		"resources/**",
		"!resources/apps/**",
		"!resources/mcp/gmail-smtp/**",
		"!resources/mcp/resend/**",
		"!resources/skills/**",
		"!resources/sounds/**",
		"!resources/svgs/**",
		"!resources/providers/**/*.svg"
	],
	"icon": "./resources/icons/win/icon.ico",
	"fileAssociations": [
		{
			"ext": "tsrct",
			"name": "Kucedr Document",
			"description": "Kucedr Document File",
			"mimeType": "application/x-kucedr-document",
			"role": "Manager",
			"icon": "./resources/icons/icon.png"
		}
	],
	"protocols": [
		{
			"name": "Kucedr Authentication",
			"schemes": ["kucedr"]
		}
	],
	"publish": null,
	"asar": true,
	"asarUnpack": [
		"node_modules/@openai/codex*/**/*",
		"node_modules/@anthropic-ai/sandbox-runtime/vendor/**/*",
		"node_modules/@silvia-odwyer/photon-node/**/*",
		"node_modules/node-pty/**/*"
	],
	"nodeGypRebuild": false,
	"buildDependenciesFromSource": false,
	"npmRebuild": true,
	"mac": {
		"target": [
			{
				"target": "pkg",
				"arch": ["x64", "arm64"]
			},
			{
				"target": "dmg",
				"arch": ["x64", "arm64"]
			}
		],
		"icon": "./resources/icons/mac/icon.icns",
		"extendInfo": {
			"LSApplicationCategoryType": "public.app-category.utilities",
			"NSMicrophoneUsageDescription": "Kucedr needs access to your microphone for audio recording features.",
			"NSCameraUsageDescription": "Kucedr needs access to your camera for video recording features.",
			"NSBluetoothAlwaysUsageDescription": "Kucedr needs access to Bluetooth to connect and manage Bluetooth devices.",
			"NSBluetoothPeripheralUsageDescription": "Kucedr needs access to Bluetooth peripherals for device connectivity.",
			"CFBundleDocumentTypes": [
				{
					"CFBundleTypeName": "Kucedr File",
					"CFBundleTypeIconFile": "fileIcon.icns",
					"CFBundleTypeExtensions": ["tsrct"],
					"CFBundleTypeRole": "Manager",
					"LSHandlerRank": "Owner",
					"LSItemContentTypes": ["com.kucedr.kucedr.document"]
				}
			],
			"UTExportedTypeDeclarations": [
				{
					"UTTypeIdentifier": "com.kucedr.kucedr.document",
					"UTTypeDescription": "Kucedr File",
					"UTTypeConformsTo": ["public.data"],
					"UTTypeTagSpecification": {
						"public.filename-extension": ["tsrct"],
						"public.mime-type": ["application/x-kucedr-document"]
					}
				}
			]
		},
		"artifactName": "${productName}-${version}-${arch}.${ext}",
		"darkModeSupport": true,
		"hardenedRuntime": true,
		"gatekeeperAssess": false,
		"entitlements": "./resources/entitlements.mac.plist",
		"entitlementsInherit": "./resources/entitlements.mac.plist",
		"notarize": true,
		"type": "distribution",
		"extraResources": [
			{
				"from": "./resources",
				"to": "resources",
				"filter": [
					"**/*",
					"!apps/**",
					"!mcp/gmail-smtp/**",
					"!mcp/resend/**",
					"!skills/**",
					"!sounds/**",
					"!svgs/**",
					"!providers/**/*.svg"
				]
			}
		]
	},
	"pkg": {
		"allowAnywhere": true,
		"allowCurrentUserHome": true,
		"allowRootDirectory": true,
		"isRelocatable": false,
		"isVersionChecked": true,
		"hasStrictIdentifier": true,
		"overwriteAction": "upgrade",
		"artifactName": "${productName}-installer-${version}-${arch}.${ext}"
	},
	"linux": {
		"target": [
			{ "target": "deb", "arch": ["x64"] },
			{ "target": "AppImage", "arch": ["x64"] },
			{ "target": "tar.gz", "arch": ["x64"] }
		],
		"category": "Utility",
		"artifactName": "${productName}-${version}.${ext}",
		"icon": "./resources/icons/png",
		"maintainer": "Kucedr Project",
		"synopsis": "Your desktop AI copilot for everyday tasks",
		"description": "Kucedr is a cross-platform desktop AI assistant that turns conversations into actions. Type or speak a request, attach images or PDFs, and let the agent work with files, run commands, research the web, create media, or automate recurring tasks.",
		"vendor": "Kucedr Project",
		"executableName": "kucedr-desktop",
		"desktop": {
			"entry": {
				"Type": "Application",
				"Name": "Kucedr",
				"Comment": "Your desktop AI copilot for everyday tasks",
				"Icon": "kucedr",
				"Terminal": false,
				"Categories": "Office;WordProcessor;AI;",
				"MimeType": "application/x-kucedr-document;",
				"StartupNotify": true,
				"StartupWMClass": "Kucedr"
			}
		},
		"extraResources": [
			{
				"from": "./resources",
				"to": "resources",
				"filter": [
					"**/*",
					"!apps/**",
					"!mcp/gmail-smtp/**",
					"!mcp/resend/**",
					"!skills/**",
					"!sounds/**",
					"!svgs/**",
					"!providers/**/*.svg"
				]
			}
		]
	},
	"deb": {
		"packageCategory": "utils",
		"maintainer": "Kucedr Project <contact@kucedr.org>",
		"depends": [
			"libgtk-3-0",
			"libnss3",
			"libxss1",
			"libasound2",
			"libatk-bridge2.0-0",
			"libgdk-pixbuf2.0-0",
			"libx11-xcb1",
			"libxcomposite1",
			"libxdamage1",
			"libxrandr2",
			"libxcursor1",
			"libxext6",
			"libxcb1",
			"libnspr4",
			"libdrm2",
			"libcups2",
			"libexpat1",
			"libpulse0",
			"libv4l-0",
			"bubblewrap",
			"socat",
			"ripgrep"
		]
	},
	"win": {
		"icon": "./resources/icons/win/icon.ico",
		"target": [
			{ "target": "nsis", "arch": ["x64"] },
			{ "target": "portable", "arch": ["x64"] }
		],
		"signAndEditExecutable": true,
		"artifactName": "${productName}.${ext}",
		"forceCodeSigning": true,
		"signtoolOptions": {
			"publisherName": "Kucedr Project"
		},
		"requestedExecutionLevel": "asInvoker",
		"extraResources": [
			{
				"from": "./resources",
				"to": "resources",
				"filter": [
					"**/*",
					"!apps/**",
					"!mcp/gmail-smtp/**",
					"!mcp/resend/**",
					"!skills/**",
					"!sounds/**",
					"!svgs/**",
					"!providers/**/*.svg"
				]
			}
		]
	},
	"nsis": {
		"oneClick": false,
		"allowToChangeInstallationDirectory": true,
		"createDesktopShortcut": true,
		"shortcutName": "Kucedr",
		"multiLanguageInstaller": true,
		"warningsAsErrors": false,
		"deleteAppDataOnUninstall": false,
		"installerIcon": "./resources/icons/win/icon.ico",
		"uninstallerIcon": "./resources/icons/win/icon.ico",
		"perMachine": false,
		"artifactName": "${productName}-${version}.${ext}",
		"displayLanguageSelector": true,
		"runAfterFinish": false,
		"language": "1040",
		"installerLanguages": ["it-IT", "en-US", "es-ES", "fr-FR", "de-DE"]
	},
	"portable": {
		"artifactName": "${productName}-Portable-${version}-${arch}.${ext}",
		"requestExecutionLevel": "user"
	}
}
